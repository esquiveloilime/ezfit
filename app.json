{
  "expo": {
    "name": "ezfit",
    "slug": "ezfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ezfit",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.uabc.ezfit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mx.uabc.ezfit"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ezfit usa tu ubicación para medir la distancia y dibujar la ruta de tus carreras y caminatas.",
          "locationAlwaysAndWhenInUsePermission": "ezfit usa tu ubicación mientras grabas una actividad, también con la pantalla apagada, para medir la distancia y dibujar la ruta.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89c88c25-d517-49d1-8b22-53692c6d614e"
      }
    },
    "owner": "esquiveloilime"
  }
}
